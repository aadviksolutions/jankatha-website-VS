{
    frankenphp
    order php_server before file_server
}

:{$PORT:-80} {
    root * /app/public
    encode zstd gzip

    php_server {
        index index.php
    }

    # Static asset caching
    @static {
        file
        path *.ico *.css *.js *.gif *.webp *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, must-revalidate"
}
